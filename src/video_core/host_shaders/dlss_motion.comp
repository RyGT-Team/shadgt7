// DLSS-GT7-001 (ryty_gpu/ryty_dlssg.cpp): GT7's motion vectors, made fit for DLSS. The game
// writes, for each pixel, where it is in this frame as drawn (with the frame's sub-pixel jitter)
// minus where it was in the frame before without jitter; its own temporal pass takes the jitter
// back out as it reads them (history at position - jitter - motion). DLSS wants the motion alone:
// the frame's jitter, in the vectors' own unit, is added back here. A vector under -1000 is the
// game's mark for "no history" (mirrors, monitors): no motion is given there.
//
// In a menu whose interface goes into DLSS's picture (mask on), the interface has no motion of
// its own: the display before its interface is compared with the display DLSS gets, and where
// they differ the interface drew. Some of it stays put on the screen while the scene under it
// moves (the garage's labels, with the camera turning round the car), some follows the scene
// (the World Map's icons, pinned to places on the map while its camera flies). For each pixel at
// or next to the interface (DLSS takes a pixel's motion from its nearest neighbour in depth, and
// the interface has no depth of its own), the interface's pixels around it (every other pixel of
// a 13x13 square: a 3x3 one chose wrongly for 10 to 44% of a map icon's pixels inside its flat
// black and white squares, 2026-11-12) are matched against the picture DLSS got in the frame
// before, once where they are and once where the scene's motion says they came from: no motion
// when staying put matches better, the scene's motion otherwise.
// The first frame of a run has no picture before: no motion there. This frame's picture is kept
// for the next.

#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D game_motion;
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D motion;

layout(set = 0, binding = 2) uniform texture2D scene;    // the display before its interface
layout(set = 0, binding = 3) uniform texture2D shown;    // the display as DLSS gets it
layout(set = 0, binding = 4) uniform texture2D previous; // the frame before's, as DLSS got it
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D keep; // this frame's, for the next

layout(push_constant) uniform Constants {
    vec2 jitter;     // the frame's jitter constants (c20, c21), in the vectors' unit
    vec2 to_pixels;  // vector * to_pixels = where the pixel was - where it is, in pixels
    float mask;      // 1: the interface's motion is chosen as above
    float threshold; // the least difference taken for the interface
    float have_previous; // 1: previous holds the frame before's picture
    float unused;
} constants;

ivec2 Clamped(ivec2 at, ivec2 size) {
    return clamp(at, ivec2(0), size - 1);
}

bool InterfaceAt(ivec2 at, ivec2 size) {
    at = Clamped(at, size);
    const vec3 d = abs(texelFetch(shown, at, 0).rgb - texelFetch(scene, at, 0).rgb);
    return max(max(d.r, d.g), d.b) > constants.threshold;
}

float Distance(vec3 a, vec3 b) {
    const vec3 d = abs(a - b);
    return d.r + d.g + d.b;
}

void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(motion);
    if (any(greaterThanEqual(at, size))) {
        return;
    }
    vec2 vector = texelFetch(game_motion, at, 0).xy;
    vector = vector.x < -1000.0 ? vec2(0.0) : vector + constants.jitter;
    if (constants.mask > 0.5) {
        bool drawn[9];
        bool beside = false;
        for (int k = 0; k < 9; ++k) {
            drawn[k] = InterfaceAt(at + ivec2(k % 3 - 1, k / 3 - 1), size);
            beside = beside || drawn[k];
        }
        if (beside) {
            bool stays = true;
            if (constants.have_previous > 0.5) {
                const ivec2 from = at + ivec2(round(vector * constants.to_pixels));
                float staying = 0.0;
                float following = 0.0;
                for (int k = 0; k < 49; ++k) {
                    const ivec2 offset = 2 * ivec2(k % 7 - 3, k / 7 - 3);
                    if (!InterfaceAt(at + offset, size)) {
                        continue;
                    }
                    const vec3 now = texelFetch(shown, Clamped(at + offset, size), 0).rgb;
                    staying += Distance(now, texelFetch(previous, Clamped(at + offset, size), 0).rgb);
                    following +=
                        Distance(now, texelFetch(previous, Clamped(from + offset, size), 0).rgb);
                }
                stays = staying <= following;
            }
            if (stays) {
                vector = vec2(0.0);
            }
        }
        imageStore(keep, at, vec4(texelFetch(shown, at, 0).rgb, 1.0));
    }
    imageStore(motion, at, vec4(vector, 0.0, 0.0));
}
